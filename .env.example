NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=file:./assurapay.db
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
NOTIFICATION_PROVIDER=sandbox
PAYMENT_PROVIDER_SANDBOX=true
WEBHOOK_SECRET=replace-me
# Identity assertion signing (Engine 01). Comma-separated keyId:secret pairs;
# each secret must be at least 32 characters. Rotate by adding a new key,
# moving ACTIVE_KEY_ID to it, then removing the old key once assertions
# signed with it have expired. Unset means assertions fail closed.
IDENTITY_ASSERTION_KEYS=key-1:replace-me-with-a-32-char-minimum-secret
IDENTITY_ASSERTION_ACTIVE_KEY_ID=key-1
AI_PROVIDER=sandbox
