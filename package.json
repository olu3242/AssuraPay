{
  "name": "assurapay",
  "version": "0.1.0",
  "private": true,
  "description": "Execution assurance and conditional payment platform foundation for AssuraPay.",
  "author": "Zenith AI Automation Agency",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "start": "npm --workspace apps/web run start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --testNamePattern=integration",
    "test:e2e": "vitest run --testNamePattern=e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:reset": "node scripts/reset-db.js",
    "db:migrate": "node scripts/run-migrations.js",
    "db:seed": "node scripts/seed-data.js",
    "certify": "npm run lint && npm run typecheck && npm run test",
    "certify:identity": "vitest run packages/identity",
    "certify:tenancy": "vitest run packages/organizations packages/database/src/trust-migrations.integration.test.ts",
    "certify:authorization": "vitest run packages/permissions",
    "certify:party-verification": "vitest run packages/parties",
    "certify:legal": "vitest run packages/legal",
    "certify:batch1": "npm run certify && npm run test:integration && npm run test:e2e && npm run build",
    "certify:execution": "vitest run packages/governance-core/src/governance-core.test.ts --testNamePattern=06",
    "certify:milestones": "vitest run packages/governance-core/src/governance-core.test.ts --testNamePattern=07",
    "certify:dod": "vitest run packages/governance-core/src/governance-core.test.ts --testNamePattern=08",
    "certify:certification": "vitest run packages/governance-core/src/governance-core.test.ts --testNamePattern=09",
    "certify:payment-triggers": "vitest run packages/governance-core/src/governance-core.test.ts --testNamePattern=10",
    "certify:batch2-governance": "npm run certify && npm run test:integration && npm run test:e2e && npm run build",
    "certify:authoring": "vitest run packages/agreement-creation/src/agreement-creation.test.ts --testNamePattern=11",
    "certify:clauses": "vitest run packages/agreement-creation/src/agreement-creation.test.ts --testNamePattern=12",
    "certify:negotiation": "vitest run packages/agreement-creation/src/agreement-creation.test.ts --testNamePattern=13",
    "certify:approvals": "vitest run packages/agreement-creation/src/agreement-creation.test.ts --testNamePattern=14",
    "certify:digital-execution": "vitest run packages/agreement-creation/src/agreement-creation.test.ts --testNamePattern=15",
    "certify:batch3": "npm run certify && npm run test:integration && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "framer-motion": "^11.11.9",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "keywords": [
    "escrow",
    "payment-assurance",
    "non-custodial",
    "fintech",
    "africa",
    "b2b-payments",
    "public-sector",
    "zenith-ai"
  ]
}
